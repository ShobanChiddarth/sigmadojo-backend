{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/log-datasets": {
      "get": {
        "summary": "Get Log Datasets",
        "description": "Returns a json list of dataset names\n\nExample:\n```json\n[\n    \"web_access\",\n    \"sysmon\",\n    \"windows_security\"\n]\n```",
        "operationId": "get_log_datasets_log_datasets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          }
        }
      }
    },
    "/validate-rule": {
      "post": {
        "summary": "Validate Rule",
        "description": "- `rule`: has to be base64 encoded\n\nis soft and will return json object\n```json\n{\n    \"valid\": bool,\n    \"error\": str\n}\n```\nas long as proper base64 encoded string is given",
        "operationId": "validate_rule_validate_rule_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRulePayloadObject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VaidateRuleReturnObject"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/run-rule": {
      "post": {
        "summary": "Run Rule",
        "description": "Do not directly call from frontend, is used for playground and \"correct answer\" execution.\n\nArbitrary rule execution against provided dataset.\n\n- `rule`: has to be base64 encoded\n- `dataset`: has to be any of the items returned by `GET /log-datasets`\n\nis hard and will throw error when rule is not valid",
        "operationId": "run_rule_run_rule_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRulePayloadObject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunRuleReturnObject"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/challenges": {
      "get": {
        "summary": "Get Challenges Wrapper",
        "description": "Gives the entire `challenges` table in json.\n\nLooks like:\n```jsonc\n[\n  {\n    \"id\": 1,\n    \"title\": \"title of challenge\",\n    \"question\": \"Imagine long question here\",\n    \"dataset\": \"web_access\", // hardcoded\n    \"correct_answer\": \"base64_encoded_sigma_rule\"\n  }\n]\n```",
        "operationId": "get_challenges_wrapper_challenges_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "items": {
                        "$ref": "#/components/schemas/ChallengeResponse"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Challenges Wrapper Challenges Get"
                }
              }
            }
          }
        }
      }
    },
    "/challenges/{id}": {
      "get": {
        "summary": "Get Challenges By Id",
        "description": "Gives one row of the challenges table, match `id`\n\n```jsonc\n{\n  \"id\": 1,\n  \"title\": \"title of challenge\",\n  \"question\": \"Imagine long question here\",\n  \"dataset\": \"web_access\", // hardcoded\n  \"correct_answer\": \"base64_encoded_sigma_rule\"\n}\n```",
        "operationId": "get_challenges_by_id_challenges__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Run Challenge",
        "description": "Executes the given sigma rule for the given challenge (by `id`) and returns output and score.\n\n`score = ( (true_positive - (false_positive + false_negative)) / total ) * 100`\n\nRequest sample:\n```json\n{\n  \"rule\": \"base64_encoded_string\"\n}\n```\n\nResponse sample:\n```jsonc\n{\n  \"score\": 0,\n  \"true_positive\": 0,\n  \"false_positive\": 0,\n  \"false_negative\": 0,\n  \"total\": 0,\n  \"current_result\": {...}, // internally called `run_rule`\n  \"correct_result\": {...}, // retrieved from global state, which was loaded from DB at startup\n}\n```",
        "operationId": "run_challenge_challenges__id__post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunChallengePayloadObject"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunChallengeResponseObject"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/validate-sigma-rule": {
      "post": {
        "summary": "Validate Sigma Rule Handler",
        "description": "- `rule`: base64 rule, or else error\n\nis soft and wont throw error when sigma rule is invalid\n\nPayload:\n```json\n{\n  \"rule\": \"base64_encoded_string\"\n}\n```\n\nResponse:\n```json\n{\n  \"valid\": true,\n  \"error\": \"nil\"\n}\n```",
        "operationId": "validate_sigma_rule_handler_validate_sigma_rule_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateSigmaRulePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateSigmaRuleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transpile-rule": {
      "post": {
        "summary": "Transpile Sigma Rule Handler",
        "description": "is hard\n- `rule`: base64 encoded, valid sigma rule, or else error\n- `target`: enum('splunk_sql', 'sentinel_kql') or else error\n\nPayload:\n```json\n{\n  \"rule\": \"base64_encoded_string\",\n  \"target\": \"splunk_spl\"\n}\n```\n\nResponse:\n```json\n{\n  \"query\": \"string\"\n}\n```",
        "operationId": "transpile_sigma_rule_handler_transpile_rule_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranspileRulePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranspileRuleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChallengeResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "dataset": {
            "type": "string",
            "title": "Dataset"
          },
          "correct_answer": {
            "type": "string",
            "title": "Correct Answer"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "question",
          "dataset",
          "correct_answer"
        ],
        "title": "ChallengeResponse",
        "description": "ORM model for challenge metadata.\n\nFields:\n- id: integer primary key\n- title: short human-readable title\n- question: textual description of the challenge\n- dataset: dataset identifier/path used by the challenge\n- correct_answer: stored as text (base64)"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunChallengePayloadObject": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule",
            "example": "base64_encoded_string"
          }
        },
        "type": "object",
        "required": [
          "rule"
        ],
        "title": "RunChallengePayloadObject",
        "description": "- `rule`: base64 encoded string\n    "
      },
      "RunChallengeResponseObject": {
        "properties": {
          "score": {
            "type": "number",
            "title": "Score"
          },
          "true_positive": {
            "type": "integer",
            "title": "True Positive"
          },
          "false_positive": {
            "type": "integer",
            "title": "False Positive"
          },
          "false_negative": {
            "type": "integer",
            "title": "False Negative"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "current_result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Current Result"
          },
          "correct_result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Correct Result"
          }
        },
        "type": "object",
        "required": [
          "score",
          "true_positive",
          "false_positive",
          "false_negative",
          "total",
          "current_result",
          "correct_result"
        ],
        "title": "RunChallengeResponseObject"
      },
      "RunRulePayloadObject": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule",
            "example": "base64encoded_string"
          },
          "dataset": {
            "type": "string",
            "title": "Dataset",
            "example": "sysmon/windows_security/web_access"
          }
        },
        "type": "object",
        "required": [
          "rule",
          "dataset"
        ],
        "title": "RunRulePayloadObject"
      },
      "RunRuleReturnObject": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count",
            "example": "number of `result`"
          },
          "result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Result",
            "example": "list of filtered `events` in .ndjson files"
          }
        },
        "type": "object",
        "required": [
          "count",
          "result"
        ],
        "title": "RunRuleReturnObject"
      },
      "TranspileRulePayload": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule",
            "example": "base64_encoded_string"
          },
          "target": {
            "type": "string",
            "title": "Target",
            "example": "splunk_spl|sentinel_kql"
          }
        },
        "type": "object",
        "required": [
          "rule",
          "target"
        ],
        "title": "TranspileRulePayload"
      },
      "TranspileRuleResponse": {
        "properties": {
          "queries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Queries"
          },
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "queries",
          "error"
        ],
        "title": "TranspileRuleResponse"
      },
      "VaidateRuleReturnObject": {
        "properties": {
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "valid",
          "error"
        ],
        "title": "VaidateRuleReturnObject"
      },
      "ValidateRulePayloadObject": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule",
            "example": "base64encoded_string"
          }
        },
        "type": "object",
        "required": [
          "rule"
        ],
        "title": "ValidateRulePayloadObject"
      },
      "ValidateSigmaRulePayload": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule",
            "example": "base64_encoded_string"
          }
        },
        "type": "object",
        "required": [
          "rule"
        ],
        "title": "ValidateSigmaRulePayload"
      },
      "ValidateSigmaRuleResponse": {
        "properties": {
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "valid",
          "error"
        ],
        "title": "ValidateSigmaRuleResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
